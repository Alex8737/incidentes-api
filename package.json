{
  "name": "incidentes-api",
  "version": "4.0.0",
  "description": "Plataforma de gestión de incidentes: API REST segura (JWT, roles, validación, HTTPS, logs, health check) lista para desplegar (Reto 4 - Unidad 8)",
  "main": "src/server.js",
  "scripts": {
    "setup": "npm install && npm run db:preparar",
    "iniciar": "npm run setup && node src/server.js",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:preparar": "node scripts/crear-env.js && npm run db:migrate && npm run db:seed",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "db:reset": "sequelize-cli db:seed:undo:all && sequelize-cli db:migrate:undo:all && npm run db:migrate && npm run db:seed",
    "db:esquema": "node scripts/exportar-esquema.js",
    "test": "jest",
    "test:evidencia": "node scripts/guardar-evidencia.js test",
    "demo": "node scripts/demo-api.js",
    "test:unit": "jest tests/unit",
    "test:integracion": "jest tests/integracion",
    "test:cobertura": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:reporte": "node scripts/guardar-evidencia.js lint",
    "evidencia": "node scripts/guardar-evidencia.js todo",
    "generar": "node scripts/generar-incidentes.js",
    "medir": "node scripts/medir-rendimiento.js",
    "medir:antes": "node linea-base/scripts/medir-rendimiento.js antes 20000 docs/reportes",
    "medir:despues": "node scripts/medir-rendimiento.js despues 20000",
    "start:prod": "sequelize-cli db:migrate && sequelize-cli db:seed:all && node src/server.js",
    "verificar": "node scripts/verificar-despliegue.js",
    "test:produccion": "jest tests/integracion/produccion.test.js tests/unit/env.test.js tests/unit/limiteLogin.test.js"
  },
  "engines": {
    "node": ">=18.18"
  },
  "author": "Alex Logacho",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.5",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "sequelize-cli": "^6.6.2",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "babel-jest": "^29.7.0",
    "eslint": "^9.15.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}
