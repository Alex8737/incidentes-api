# ===============================================================
#  Copie este archivo como ".env" y ajuste los valores.
#  ".env" NUNCA se sube al repositorio (está en .gitignore).
#  En producción (Render) estas variables se cargan en el panel del
#  proveedor, NO en un archivo. Ver docs/DESPLIEGUE.md.
# ===============================================================

# development | test | production
NODE_ENV=development
PORT=3000

# Orígenes permitidos para CORS (separados por coma).
# Si el front se sirve desde el mismo dominio que la API (este proyecto), en producción déjelo vacío.
# En producción solo se admiten orígenes https://
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:5500

# ---------- Base de datos ----------
# Opción A (recomendada en la nube): una sola URL que entrega el proveedor
#   DATABASE_URL=postgres://usuario:clave@host:5432/nombre?sslmode=require
# Opción B: variables sueltas
# Motor: sqlite (por defecto, no requiere servidor) | mysql | postgres
DB_DIALECT=sqlite

# Solo para SQLite: ruta del archivo de base de datos
DB_STORAGE=database/incidentes.sqlite

# Solo para MySQL / PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=incidentes_db
DB_USER=incidentes_app
DB_PASSWORD=cambie_esta_clave
# true para exigir conexión cifrada TLS con el servidor de BD
DB_SSL=false

# Muestra las consultas SQL generadas por el ORM en consola (true/false)
DB_LOGGING=false

# ---------- Seguridad ----------
# Secreto para firmar los tokens JWT. Mínimo 32 caracteres. CÁMBIELO antes de usar.
# Generar uno:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambie-este-secreto-por-uno-largo-y-aleatorio-32+
# Duración de la sesión (ej.: 8h, 30m, 1d)
JWT_EXPIRA=8h

# ---------- Producción (Reto 4) ----------
# Redirigir HTTP -> HTTPS (por defecto: true solo en production)
# FORCE_HTTPS=true
# Saltos de proxy en los que confiar para detectar HTTPS (Render = 1; por defecto 1 solo en production)
# TRUST_PROXY=1
# Formato de logs: json (producción) | texto (desarrollo)
# LOG_FORMAT=json
# Intentos fallidos de login por IP y ventana (minutos) antes de responder 429
# LOGIN_MAX_INTENTOS=10
# LOGIN_VENTANA_MIN=15

# ---------- Cuentas iniciales (seeder) ----------
# En producción son OBLIGATORIAS (mínimo 10 caracteres). En local, si faltan, se usan claves de demostración.
# SEED_ADMIN_PASSWORD=
# SEED_ANALISTA_PASSWORD=
# SEED_VISOR_PASSWORD=
